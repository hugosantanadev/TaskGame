# Copie para .env e preencha:  cp .env.example .env
# O Docker Compose e o backend rodando fora do Docker leem este arquivo. O .env não vai para o Git.

# Segredo que assina os access tokens (HS256). No mínimo 32 bytes aleatórios. Gere com:
#   Linux, macOS ou Git Bash:  openssl rand -base64 48
#   PowerShell:                [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# Usuário e senha do PostgreSQL criado pelo Compose
DB_USER=gasmtask
DB_PASSWORD=gasmtask

# true exige HTTPS para o cookie de sessão. Em http://localhost use false;
# atrás de HTTPS (túnel ou produção), use true.
AUTH_COOKIE_SECURE=false
